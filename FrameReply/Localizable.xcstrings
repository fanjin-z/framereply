    "provider.consent.message" : {
      "comment" : "Privacy disclosure. The placeholder is the third-party provider brand.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "FrameReply will send the messages, images, names, saved personal context, and drafts you select directly to %@, a third-party AI provider, to analyze chats and create replies."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrameReply 会将你选择的消息、图片、名称、已保存的个人信息和草稿直接发送给第三方 AI 服务商%@，用于分析聊天并生成回复。"
          }
        }
      }
    },
    "provider.consent.summary" : {
      "comment" : "Detailed provider privacy disclosure. The placeholder describes the processing destination.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "FrameReply sends selected screenshots or message text, participant names, chat context, saved personal context, and drafts to %@ to analyze conversations and generate replies. Your provider may retain request data under its policy and may charge your provider account. FrameReply does not operate a proxy server."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
